# Local-only Personal AI Messaging Agent
# Copy to .env. Never commit real values. Never put Google/Microsoft/platform passwords here.

# Bind — localhost only. Do not change HOST to 0.0.0.0 unless you accept LAN exposure.
HOST=127.0.0.1
PORT=8787
FRONTEND_PORT=5173

# Local encryption key for stored OAuth refresh tokens (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is NOT a Microsoft, Google, or Free4Talk password.
AGENT_DATA_KEY=

# Optional OpenAI-compatible API for draft generation. Leave empty to use the on-device heuristic drafter.
# Never paste a platform login password here.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Microsoft Graph public-client app (device code flow). No client secret.
# Register in Entra admin center: public client, "Allow public client flows" = Yes.
# Delegated permissions: User.Read, Chat.ReadWrite, ChatMessage.Send. Admin consent may be required by your tenant.
# Work or school accounts only. Personal Microsoft accounts are not supported by Teams chat Graph APIs.
# Leave empty until you have an app registration — the connector will report "not configured", not a fake login.
TEAMS_CLIENT_ID=
TEAMS_TENANT_ID=organizations
