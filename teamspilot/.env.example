# TeamsPilot local configuration
# Copy to .env if you want local overrides. Do not commit .env.
# Do not put a real OpenAI key or a Microsoft password in this file.
# On Windows, API keys and the Microsoft token cache are stored in
# Windows Credential Manager. This file is only an optional seed.

# Localhost port. The server refuses non-loopback connections.
PORT=47321

# Optional data directory. Defaults to %APPDATA%\TeamsPilot on Windows.
TEAMSPILOT_DATA_DIR=

# Optional seed for the OpenAI API key. Prefer the Settings page,
# which stores the key in Windows Credential Manager.
# Leave blank here. Example shape only: sk-your-key-here
TEAMSPILOT_OPENAI_API_KEY=

# Application (client) ID from your Entra app registration.
# This is a public client id, not a client secret. Do not create a secret.
TEAMSPILOT_GRAPH_CLIENT_ID=

# organizations, a tenant id, or a tenant domain.
# Personal Microsoft accounts are not supported for Teams chat APIs.
TEAMSPILOT_GRAPH_TENANT=organizations
