{
  "name": "teamspilot",
  "version": "1.0.0",
  "private": true,
  "description": "Local Windows assistant that drafts Microsoft Teams replies and sends only after explicit approval.",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server/cli.ts",
    "build": "vite build && esbuild src/server/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js --sourcemap && node scripts/copy-assets.cjs",
    "start": "node scripts/start.cjs",
    "app": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.50",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^33.4.11",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
