# Database (auto-filled by Railway Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session
SESSION_SECRET=replace-with-a-long-random-string

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
CALLBACK_URL=https://your-app.railway.app/api/auth/callback

# Optional APIs
# Giphy GIF search (server-side only — never use NEXT_PUBLIC_GIPHY_API_KEY).
# Required for GIF search. Create an app at https://developers.giphy.com/dashboard
GIPHY_API_KEY=your-giphy-key
YOUTUBE_API_KEY=your-youtube-key

# PayPal (VIP support — Buy Me a Coffee opens in-app PayPal VIP tiers)
# Account Settings → Business information → Merchant ID
# Set on Railway web service. Do not commit the real ID.
PAYPAL_MERCHANT_ID=your-paypal-merchant-id
# Optional: set true only when testing with sandbox.paypal.com
# PAYPAL_SANDBOX=false

# OpenAI — required for Talking AI (chat + stream). No silent mock fallback.
OPENAI_API_KEY=sk-...
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-...   # alternate name also accepted
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ElevenLabs (AI Tutor voice) — use Admin panel voice IDs; do not leave blank if provider=elevenlabs
# Get free keys at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEYS=sk_yourFirstKey...,sk_yourSecondKey...
# Optional voice overrides (also configurable in Admin → AI Tutor)
# ELEVENLABS_EVA_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MALE_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Environment
NODE_ENV=production
