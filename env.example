# Database (auto-filled by Railway Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session
SESSION_SECRET=replace-with-a-long-random-string

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
CALLBACK_URL=https://your-app.railway.app/api/auth/callback

# Optional APIs
# Giphy GIF search (server-side only — never use NEXT_PUBLIC_GIPHY_API_KEY).
# Free beta keys do not expire; they are capped at ~100 requests/hour.
# There is no unlimited never-expiring public Giphy key.
# If this is unset, GIF search falls back to Wikimedia Commons (no key).
# Create an app at https://developers.giphy.com/dashboard → copy the API key.
GIPHY_API_KEY=your-giphy-key
YOUTUBE_API_KEY=your-youtube-key

# PayPal (VIP support — replaces Buy Me a Coffee)
# Account Settings → Business information → Merchant ID
# Set on Railway web service. Do not commit the real ID.
PAYPAL_MERCHANT_ID=your-paypal-merchant-id
# Optional: set true only when testing with sandbox.paypal.com
# PAYPAL_SANDBOX=false
# Merchant-ID photo scan uses the existing OpenAI key (server-side only):
# OPENAI_API_KEY=...
# AI_INTEGRATIONS_OPENAI_API_KEY=...
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ElevenLabs (AI Tutor "Eva" voice) — optional
# If unset, only the browser-voice personas (Female "Afi K" / Male "Dude") work
# and tapping Eva will show a "voice unavailable" toast.
# Get free keys at https://elevenlabs.io/app/settings/api-keys (10k chars/mo each).
# Comma-separated list to multiply the free quota — keys are rotated round-robin.
ELEVENLABS_API_KEYS=sk_yourFirstKey...,sk_yourSecondKey...
# Optional voice overrides (default: Rachel for Eva, Adam for Male)
# ELEVENLABS_EVA_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Environment
NODE_ENV=production
